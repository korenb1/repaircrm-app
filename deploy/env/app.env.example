# Copy to /srv/repaircrm/<env>/app/.env.production, fill in, then:
#   chown deploy:deploy .env.production && chmod 600 .env.production
#
# Values below are the PROD shape. For staging swap:
#   db.domain.com        -> db-staging.domain.com
#   app.domain.com       -> testapp.domain.com
#   PORT 3000            -> 3001
#   127.0.0.1:5432       -> 127.0.0.1:5433
# ...and use different secrets everywhere.

PORT=3000

# Public hostname — this string is inlined into the browser bundle at build
# time, so prod and staging need separate builds. Never point it at localhost.
NEXT_PUBLIC_SUPABASE_URL=https://db.domain.com

# From: node deploy/supabase/gen-keys.mjs "$JWT_SECRET"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Must be byte-identical to JWT_SECRET in the matching supabase/.env, otherwise
# every token minted by src/lib/supabase/jwt.ts is rejected with a 401.
SUPABASE_JWT_SECRET=

# Better Auth talks straight to Postgres (bypasses PostgREST/RLS).
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres

# openssl rand -base64 32 — unique per environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.domain.com

NEXT_PUBLIC_TINYMCE_API_KEY=

# Used only by `npm run create-admin` on first boot.
ADMIN_EMAIL=admin@domain.com
ADMIN_PASSWORD=
