# Copy to /srv/repaircrm/<env>/supabase/.env and fill in.
# PROD AND STAGING MUST HAVE DIFFERENT SECRETS. A shared JWT_SECRET means a
# staging token unlocks prod data.

# Distinct name => distinct docker volumes => real data isolation between envs.
# prod: rcrm-prod   staging: rcrm-stg
STACK_NAME=rcrm-prod

# Host ports, loopback-bound. prod: 5432/5401/5402   staging: 5433/5411/5412
POSTGRES_PORT=5432
REST_PORT=5401
STORAGE_PORT=5402

# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32  -- must equal SUPABASE_JWT_SECRET in the app env file
JWT_SECRET=

# Generate both from JWT_SECRET:  node deploy/supabase/gen-keys.mjs "$JWT_SECRET"
ANON_KEY=
SERVICE_ROLE_KEY=
