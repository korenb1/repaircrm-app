# One auto-deploy check. Started by repaircrm-autodeploy@%i.timer, not enabled
# directly. %i resolves to prod / staging.
[Unit]
Description=repaircrm auto-deploy check (%i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/repaircrm/%i/app
ExecStart=/srv/repaircrm/%i/app/deploy/autodeploy.sh %i
# Exits in ~1s when nothing moved; a real deploy is npm ci + next build.
TimeoutStartSec=30min
