# Templated unit — one file, both environments.
#   sudo cp deploy/systemd/repaircrm@.service /etc/systemd/system/
#   sudo systemctl enable --now repaircrm@prod repaircrm@staging
# %i resolves to prod / staging.
[Unit]
Description=repaircrm (%i)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/repaircrm/%i/app/.next/standalone
# PORT lives in the env file: 3000 for prod, 3001 for staging.
EnvironmentFile=/srv/repaircrm/%i/app/.env.production
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/repaircrm/%i/app

[Install]
WantedBy=multi-user.target
